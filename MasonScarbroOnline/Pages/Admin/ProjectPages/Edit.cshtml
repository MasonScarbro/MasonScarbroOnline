@page
@model MasonScarbroOnline.Pages.ProjectPages.EditModel
@using MasonScarbroOnline.Helpers
@{
    ViewData["Title"] = "Edit";
}

<div class="mx-auto max-w-2xl px-6 py-12">
    <div class="mb-8">
        <h1 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-white">Edit Project</h1>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Update the details for this project.</p>
    </div>

    <div class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm dark:border-white/10 dark:bg-white/5">
        <form method="post" class="space-y-6">
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 dark:text-red-400"></div>
            <input type="hidden" asp-for="Project.Id" />

            @Html.EditorFor(m => m.Project.Title)
            @Html.EditorFor(m => m.Project.Description)
            @Html.EditorFor(m => m.Project.TechStack)

            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
                @Html.EditorFor(m => m.Project.ImageUrl)
                @Html.EditorFor(m => m.Project.RepoUrl)
            </div>

            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
                @Html.EditorFor(m => m.Project.DemoUrl)
                @Html.EditorFor(m => m.Project.CreatedAt)
            </div>

            <div class="flex items-center gap-4 pt-2">
                <button type="submit" class="@UiClasses.BtnPrimary">Save</button>
                <a asp-page="./Index" class="@UiClasses.BtnLink">Cancel</a>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}