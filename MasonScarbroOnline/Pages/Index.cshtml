@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center reveal is-visible">
    <h1 class="font-display text-4xl font-bold text-gray-900 dark:text-white">Welcome</h1>
    <p class="text-gray-600 dark:text-gray-400 mt-2">
        Learn about <a href="https://learn.microsoft.com/aspnet/core" class="text-accent hover:underline">building Web apps with ASP.NET Core</a>.
    </p>
</div>

<div class="mt-16" id="projects">
    <p class="font-mono text-sm text-accent mb-1 text-center">// portfolio</p>
    <h2 class="font-display text-2xl font-bold mb-6 text-center text-gray-900 dark:text-white">Projects</h2>

    @if (!Model.Projects.Any())
    {
        <p class="text-gray-500 dark:text-gray-400 text-center">No projects yet — add one to the database to see it here.</p>
    }
    else
    {
        <div class="grid gap-4">
            @for (int i = 0; i < Model.Projects.Count; i++)
            {
                var nodeId = $"project-{i}";
                <partial name="_ProjectCard" model="(Model.Projects[i], nodeId)" />
            }
        </div>
    }
</div>
<div class="text-center reveal is-visible">
    <h1 class="font-display text-4xl font-bold text-gray-900 dark:text-white">Check out the Stats:</h1>
    <div class="mt-16 max-w-2xl mx-auto">
        <partial name="_GitHubStats" model="Model.GitHubStats" />
    </div>
</div>



<div class="mt-20">
    <p class="font-mono text-sm text-accent mb-1 text-center">// timeline</p>
    <h2 class="font-display text-2xl font-bold mb-6 text-center text-gray-900 dark:text-white">Experience</h2>

    @if (!Model.Experiences.Any())
    {
        <p class="text-gray-500 dark:text-gray-400 text-center">No experience listed yet.</p>
    }
    else
    {
        <div class="relative mx-auto p-2">
            <div class="hidden md:block absolute left-1/2 top-0 bottom-0 w-1 -translate-x-1/2 bg-gray-200 dark:bg-white/10 pointer-events-none"></div>

            <div class="flex flex-col md:grid md:grid-cols-9 gap-y-8">
                @for (int i = 0; i < Model.Experiences.Count; i++)
                {
                    var nodeId = $"exp-{i}";
                    <partial name="_TimelineEntry" model="(Model.Experiences[i], i % 2 == 1, nodeId)" />
                }
            </div>
        </div>
    }
</div>
