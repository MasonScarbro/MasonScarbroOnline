<header class="sticky top-0 z-50 backdrop-blur-md bg-surface-light/80 dark:bg-surface-dark/80 border-b border-gray-200/60 dark:border-white/10">
    <div class="mx-auto max-w-6xl px-6 py-3 flex items-center justify-between">
        <a asp-page="/Index" class="flex items-center gap-3 group">
            <img src="~/imgs/profile.jfif" alt="Mason Scarbro"
                 class="w-9 h-9 rounded-full object-cover ring-2 ring-transparent group-hover:ring-accent transition" />
            <span class="font-display font-bold text-lg tracking-tight">Mason Scarbro</span>
        </a>

        <nav class="hidden md:flex items-center gap-8 font-mono text-sm text-gray-600 dark:text-gray-300">
            <a asp-page="/Index" class="hover:text-accent transition">home</a>
            <a asp-page="/About" class="hover:text-accent transition">about</a>
            <a asp-page="/Index" asp-fragment="projects" class="hover:text-accent transition">projects</a>
        </nav>

        <div class="flex items-center gap-4">
            <a href="https://github.com/MasonScarbro" target="_blank" rel="noopener" aria-label="GitHub"
               class="text-gray-500 hover:text-accent transition">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.73.5.5 5.73.5 12c0 5.1 3.29 9.4 7.86 10.93.57.1.78-.25.78-.55v-2.1c-3.2.7-3.87-1.35-3.87-1.35-.53-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.64 1.59.24 2.76.12 3.05.74.81 1.19 1.83 1.19 3.09 0 4.43-2.7 5.4-5.27 5.69.42.36.78 1.08.78 2.17v3.22c0 .3.2.66.79.55A10.99 10.99 0 0 0 23.5 12c0-6.27-5.23-11.5-11.5-11.5Z" /></svg>
            </a>
            <a href="https://linkedin.com/in/mason-scarbro-127932259" target="_blank" rel="noopener" aria-label="LinkedIn"
               class="text-gray-500 hover:text-accent transition">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45Z" /></svg>
            </a>
            <div class="relative">
                <button id="ask-toggle" aria-label="Ask about my experience"
                        class="relative w-10 h-10 flex items-center justify-center rounded-full hover:bg-gray-100 dark:hover:bg-white/10 transition text-gray-500 hover:text-accent">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                    </svg>
                </button>

                <div id="ask-panel"
                     class="hidden absolute right-0 mt-2 w-80 rounded-lg border border-gray-200 dark:border-white/10 bg-surface-light dark:bg-surface-dark shadow-lg p-4 z-50">
                    <p class="font-mono text-xs text-accent mb-1">// ask about my experience</p>
                    <p class="text-xs text-gray-500 dark:text-gray-400 mb-3">e.g. "Has he worked with Docker?"</p>

                    <div class="flex gap-2">
                        <input id="ask-input" type="text" placeholder="Ask a question..."
                               class="flex-1 rounded-md bg-white dark:bg-white/5 px-3 py-1.5 text-sm text-gray-900 dark:text-white outline-1 -outline-offset-1 outline-gray-300 dark:outline-white/10 focus:outline-2 focus:outline-accent" />
                        <button id="ask-submit"
                                class="rounded-md bg-accent px-3 py-1.5 text-sm font-semibold text-white hover:bg-accent/90 transition">
                            Ask
                        </button>
                    </div>

                    <div id="ask-answer" class="mt-3 text-sm text-gray-700 dark:text-gray-300 hidden"></div>
                    <div id="ask-loading" class="mt-3 text-xs font-mono text-gray-400 hidden">thinking...</div>
                    <div id="ask-error" class="mt-3 text-xs text-red-500 hidden"></div>
                </div>
            </div>
            <button id="theme-toggle" aria-label="Toggle dark mode"
                    class="relative w-10 h-10 flex items-center justify-center rounded-full hover:bg-gray-100 dark:hover:bg-white/10 transition">
                <svg class="w-5 h-5 text-gray-700 dark:hidden" fill="currentColor" viewBox="0 0 20 20"><path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-9.9a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 9a1 1 0 100 2h1a1 1 0 100-2h-1zM3 9a1 1 0 100 2h1a1 1 0 100-2H3zm2.343-5.657a1 1 0 010 1.414l-.707.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zm0 11.314l-.707.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 111.414 1.414zM10 16a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1z" /></svg>
                <svg class="w-5 h-5 text-gray-200 hidden dark:block" fill="currentColor" viewBox="0 0 20 20"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z" /></svg>
            </button>
        </div>
    </div>
    <div id="scroll-progress"></div>
</header>